{
  "name": "dsh-mading-toolbox",
  "version": "0.3.0",
  "private": true,
  "description": "码叮工具箱：DeepSeek Harness 的本地截图、二维码、图片压缩与 JSON 工具箱",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "homepage": "https://github.com/liulxiang/madingbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liulxiang/madingbox.git"
  },
  "bugs": {
    "url": "https://github.com/liulxiang/madingbox/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screenshot",
    "qrcode",
    "macos",
    "compress",
    "json"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
